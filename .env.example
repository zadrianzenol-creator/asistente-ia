# Copia este archivo a .env y completa los valores. NUNCA subas .env a un repositorio ni compartas las claves por chat.

# ---------- Proveedor principal y respaldo ----------
# Puedes poner una, dos o las tres claves. El principal es el primero con clave en el orden openai > anthropic > gemini,
# y los demás quedan como respaldo en cadena. El respaldo entra solo si el principal falla por saldo/cuota,
# clave inválida o saturación.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# AI_PROVIDER=anthropic     # openai | anthropic | gemini  (fuerza el principal)
# AI_FALLBACK=gemini,openai # lista en orden, o "none" para desactivar el respaldo

# ---------- OpenAI (clave de la API en platform.openai.com; NO es la suscripción ChatGPT Plus) ----------
# Estos nombres se escribieron sin poder consultar la documentación actual: verifícalos con `npm run check-key`.
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_PRO=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium        # low | medium | high | auto  (más calidad = más costo por imagen)

# ---------- Anthropic / Claude (clave de la API en console.anthropic.com; NO es la suscripción de claude.ai) ----------
# Cobra por uso. Entiende imágenes, pero no crea imágenes. Verifica los modelos con `npm run check-key`.
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_PRO=claude-sonnet-5-5
# ANTHROPIC_API_BASE=       # opcional; se ignora a propósito ANTHROPIC_BASE_URL de otras herramientas

# ---------- Google Gemini (clave gratuita: https://aistudio.google.com/apikey) ----------
# Los alias "-latest" evitan que el modelo se retire con el tiempo. Los gemini-2.5-* ya no están disponibles para cuentas nuevas.
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_PRO=gemini-3.8-flash
# 1 = permite al modelo buscar en Google para información reciente (cuota propia; sin probar)
GEMINI_SEARCH=0

# ---------- Servidor ----------
PORT=3000
# Quién responde por el servicio (aparece en /privacidad.html). Obligatorio publicar con tu nombre y un contacto real.
OPERATOR=
# 1 si tu hosting está detrás de un proxy que envía X-Forwarded-For (Render, Railway, Fly, Nginx...). Si no, déjalo en 0.
TRUST_PROXY=0
MAX_OUTPUT_TOKENS=4096

# ---------- Límites anti-abuso (sin cuentas, por IP) ----------
RATE_PER_MINUTE=12
RATE_PER_DAY=150
RATE_GLOBAL_PER_DAY=1500
MAX_CONCURRENT_PER_IP=2
# Crear/editar imágenes cuesta dinero real en OpenAI: límites propios y mucho más estrictos
IMAGE_PER_MINUTE=3
IMAGE_PER_DAY=10
IMAGE_GLOBAL_PER_DAY=200
